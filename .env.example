# Copie para .env e preencha com os dados do projeto Supabase.
# Estas duas variáveis vão para o bundle do navegador — é seguro, a anon key
# não abre nada: todas as tabelas têm RLS ligado e nenhuma policy.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON=eyJhbGciOi...

# --- SÓ PARA AS FERRAMENTAS DE LINHA DE COMANDO (nunca vai para o navegador) ---
# Usada por ferramentas/importar-elegiveis.mjs. Não commitar.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
